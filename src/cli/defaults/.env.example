# buzz-team operator configuration
# Copy to .env (never commit this file)

# ── GitHub personal access token (required for create / update / delete) ────────
# Needs: read:user, write:org (for app creation via manifest flow)
GITHUB_TOKEN=

# ── Relay SSH access (required for relay enrollment) ───────────────────────────
# Example: root@your-relay-host.com
BUZZ_RELAY_SSH=

# ── Relay SSH key (optional — omit if using ssh-agent or default key) ──────────
# Example: /path/to/keys/dokploy-ssh-key.pem
BUZZ_RELAY_SSH_KEY=

# ── Relay WebSocket URL (required for publishing the agent's Nostr profile) ────
# Example: wss://relay.example.com
BUZZ_RELAY_URL=
