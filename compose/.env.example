# buzz-team-agent compose configuration
# Copy to .env, fill in values, then run: docker compose up -d

# ── Image registry ──────────────────────────────────────────────────────────────
GHCR_OWNER=

# ── Buzz relay ──────────────────────────────────────────────────────────────────
BUZZ_RELAY_URL=

# 64-char hex Nostr private key for this agent
BUZZ_PRIVATE_KEY=

# ── GitHub App identity ─────────────────────────────────────────────────────────
# App permissions needed: Contents (R+W), Pull requests (R+W), Issues (R+W), Metadata (R)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM private key with newlines replaced by literal \n
GITHUB_APP_PRIVATE_KEY=

# ── Bot git identity ────────────────────────────────────────────────────────────
BOT_NAME=my-agent[bot]
BOT_EMAIL=my-agent[bot]@users.noreply.github.com

# ── Goose / AI harness ──────────────────────────────────────────────────────────
GOOSE_MODEL=claude-sonnet-4.6
